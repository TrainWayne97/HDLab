# Root .env.example for HDLab
# Copy to .env and adjust as needed

# Absolute path to simtmp directory (used by worker and docker-compose)
SIMTMP_HOST_PATH=/absolute/path/to/your/HDLab/simtmp

# Optional: Node environment
NODE_ENV=development

# Optional: Global PORT overrides
# FRONTEND_PORT=5174
# PORT=3001

# Add further global/project-wide variables here as needed

MONGO_URL=mongodb://mongo:27017/hdl
RABBITMQ_URL=amqp://user:password@rabbitmq:5672