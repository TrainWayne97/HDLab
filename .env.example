# ========================================
# HDLab Environment Configuration
# ========================================
# Copy this file to .env and adjust values for your environment
# Required for: Frontend, Backend, Worker, Docker Compose

# ========================================
# 📁 FILE SYSTEM
# ========================================
# Absolute path to simtmp directory (used by worker and docker-compose)
SIMTMP_HOST_PATH=/absolute/path/to/your/HDLab/simtmp

# ========================================
# 🚀 RUNTIME ENVIRONMENT
# ========================================
NODE_ENV=development
# Options: development, production, test

# ========================================
# 🔌 PORTS
# ========================================
FRONTEND_PORT=5173
BACKEND_PORT=3001
# Worker runs on 3002 (internal)
# MongoDB runs on 27017
# RabbitMQ runs on 5672

# ========================================
# 💾 DATABASE (MongoDB)
# ========================================
MONGO_URL=mongodb://mongo:27017/hdlab
# For local development: mongodb://localhost:27017/hdlab
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/hdlab

# ========================================
# 🔐 AUTHENTICATION (JWT)
# ========================================
# REQUIRED: the backend refuses to start without it, with a placeholder value
# or with fewer than 32 characters. Put it into .env.secrets (not in Git).
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=7d
# Token expiry: 1d, 7d, 30d, etc.

# ========================================
# 🔑 OAUTH2 LOGIN (GitLab)
# ========================================
APP_URL=http://localhost:8080
# Public URL of the frontend; the browser is sent back here after the GitLab login
# In production: https://yourdomain.com

GITLAB_URL=https://gitlab.imn.htwk-leipzig.de
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Application ID and Secret of the GitLab application (User Settings > Applications,
# scopes: read_user + openid, Confidential: yes). Leave empty to disable the GitLab login.
# Redirect URI to enter in GitLab: <APP_URL>/api/auth/gitlab/callback
# GITLAB_REDIRECT_URI=http://localhost:8080/api/auth/gitlab/callback

# ========================================
# 📨 MESSAGE QUEUE (RabbitMQ)
# ========================================
RABBITMQ_URL=amqp://user:password@rabbitmq:5672
# For Docker Compose: amqp://guest:guest@rabbitmq:5672
# For local: amqp://guest:guest@localhost:5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# ========================================
# 🌐 FRONTEND CONFIGURATION
# ========================================
VITE_API_URL=/api
# Backend API base URL for frontend requests
# In production: https://api.yourdomain.com/api

# ========================================
# 🐳 DOCKER & SIMULATION
# ========================================
DOCKER_HOST=unix:///var/run/docker.sock
# For Docker: unix:///var/run/docker.sock
# For Docker Desktop (Mac/Windows): Use default

VERILATOR_TIMEOUT=30000
# Maximum time (ms) for Verilator simulations

MAX_WORKERS=4
# Number of parallel simulation workers

MAX_NETLIST_RENDERS=2
# Number of submodule schematics drawn in parallel when opened in the netlist viewer

# ========================================
# 🔒 SECURITY
# ========================================
CORS_ORIGIN=http://localhost:5173
# Frontend URL for CORS policy
# In production: https://yourdomain.com

SECURE_COOKIES=false
# Set to true in production (requires HTTPS)

HTTP_ONLY_COOKIES=true
# Prevents JavaScript from accessing auth cookies

# ========================================
# 📊 LOGGING
# ========================================
LOG_LEVEL=debug
# Options: error, warn, info, debug, trace